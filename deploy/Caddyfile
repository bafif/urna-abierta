{
	admin off
	skip_install_trust
	# A browser that opens a bare IP address names no site, and behind a cloud's NAT the machine does not have
	# that address either: without this, it gets no certificate. `urna` passes the address of the site.
	default_sni {$URNA_SNI:localhost}
}

{$URNA_SITE::80} {
	{$URNA_TLS:}

	# Nothing on the page comes from anywhere else, and no other site can embed it.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/* {
		reverse_proxy {$URNA_API:server:3000}
	}

	handle {
		root * /srv
		header /service-worker.js Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}
