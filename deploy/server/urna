#!/bin/sh
# Runs Urna Abierta on a server: everything in one pod of rootless Podman, for the user `urna`.
#
#   urna estado              says whether everything is fine, and what to do if it is not
#   urna arrancar            starts it
#   urna frenar              stops it, without deleting anything
#   urna copia               makes an encrypted backup now, and sends it to the bucket if there is one
#   urna restaurar <archivo> <llave>   replaces the data with a backup
#   urna actualizar [versión]          makes a backup and moves to the newest version, or to the one given
#   urna reiniciar           creates the containers again with what .env says, keeping the data
#   urna direccion <ip o dominio>      changes the address of the site
set -eu

home=${URNA_HOME:-/opt/urna-abierta}
# The backup to restore is opened first, from the folder the command was run in, and as root when it runs as root:
# it may be where the user `urna` cannot read, like the home of whoever connected. It goes on as standard input.
if [ "${1:-}" = restaurar ] && [ $# -eq 3 ] && [ "$2" != - ]; then
  [ -f "$2" ] || { echo "No encuentro el archivo $2. Fijate la ruta, o pasala completa, como /home/ubuntu/copia.tar.gpg." >&2; exit 1; }
  [ -r "$2" ] || { echo "No puedo leer $2. Probá con sudo." >&2; exit 1; }
  exec <"$2"
  set -- restaurar - "$3"
fi
# Whoever calls this may be in a folder that this user cannot enter.
cd /

# As root, it runs as the user that owns the containers, and remembers it to say how to look at them.
if [ "$(id -u)" = 0 ] && [ "${URNA_RUN_AS_ROOT:-}" != si ]; then
  uid=$(id -u urna)
  exec runuser -u urna -- env XDG_RUNTIME_DIR="/run/user/$uid" HOME="$home" URNA_FROM_ROOT=si "$0" "$@"
fi

set -a
# shellcheck disable=SC1091
. "$home/.env"
set +a
pod=${URNA_POD:-urna}
ports=${URNA_PORTS--p 80:80 -p 443:443 -p 443:443/udp}
# The address of the site, without its scheme: what its certificate is for.
site_address() { address=${URNA_SITE#https://}; printf '%s' "${address#http://}"; }
health=${URNA_HEALTH_URL:-https://$(site_address)/api/health}
# Asks this machine as a browser asks the site, by its address: Caddy only answers for that one, with its certificate.
ask_here() { curl -fsk --connect-to ::localhost: "$@"; }
keep=${URNA_BACKUPS_KEPT:-28}

# ip: a Let's Encrypt certificate for the bare address, which lasts days and renews by itself.
# auto: the usual one for a domain. internal: only for trying it out.
tls_block() {
  case "${URNA_CERT:-ip}" in
    ip) printf 'tls {\n\tissuer acme {\n\t\tdir https://acme-v02.api.letsencrypt.org/directory\n\t\tprofile shortlived\n\t}\n}' ;;
    internal) printf 'tls internal' ;;
    *) printf '' ;;
  esac
}

network() {
  # Both keep the real address of each phone, which the limit on guessing codes needs.
  if [ -n "${URNA_NETWORK:-}" ]; then
    echo "$URNA_NETWORK"
  elif command -v pasta >/dev/null 2>&1; then
    echo pasta
  else
    echo slirp4netns:port_handler=slirp4netns
  fi
}

# The database takes the password .env gives it, each time it starts: it is the one the server uses, and an installer
# that ran again on the same machine may have made a new one. Then a database made before, which trusted every
# connection from inside the pod, asks for it on the network from then on. Its socket, which is only inside its own
# container, keeps trusting: an older «urna», after going back to an older version, still makes and restores backups.
database_password() {
  podman exec -i -e POSTGRES_PASSWORD -u postgres "$pod-db" sh -s >/dev/null 2>&1 <<'EOF' || true
for _ in $(seq 1 60); do pg_isready -q -U urna -d urna && break; sleep 1; done
psql -X -q -v ON_ERROR_STOP=1 -U urna -d urna <<'SQL' || exit 1
\getenv password POSTGRES_PASSWORD
ALTER ROLE urna PASSWORD :'password';
SQL
grep -Eq '^[[:space:]]*host.*[[:space:]]trust[[:space:]]*$' "$PGDATA/pg_hba.conf" || exit 0
sed -i -E '/^[[:space:]]*host/ s/[[:space:]]trust[[:space:]]*$/ scram-sha-256/' "$PGDATA/pg_hba.conf"
psql -X -q -U urna -d urna -c 'SELECT pg_reload_conf()'
EOF
}

start() {
  mkdir -p "$home/fotos" "$home/copias"
  if ! podman pod exists "$pod"; then
    # shellcheck disable=SC2086
    podman pod create --name "$pod" --network "$(network)" $ports >/dev/null
  fi
  # The database asks for its password on every connection over the network, which the web container shares in the pod.
  if ! podman container exists "$pod-db"; then
    podman run -d --pod "$pod" --name "$pod-db" --restart=always \
      -e POSTGRES_USER=urna -e POSTGRES_DB=urna -e POSTGRES_PASSWORD="$POSTGRES_PASSWORD" -e POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 \
      -v "$pod-database:/var/lib/postgresql" "$URNA_IMAGE_DB" \
      postgres -c shared_buffers=128MB -c max_connections=20 -c work_mem=4MB -c effective_cache_size=384MB >/dev/null
  fi
  if ! podman container exists "$pod-server"; then
    podman run -d --pod "$pod" --name "$pod-server" --restart=always \
      -e URNA_ACEPTO_RESPONSABILIDAD=si -e PG_POOL_MAX=8 -e URNA_PHOTOS_DIR=/fotos -e URNA_BACKUPS_DIR=/copias \
      -e URNA_SETUP_CODE -e URNA_SETUP_CODE_HASH -e URNA_FIELD_KEY="$URNA_FIELD_KEY" -e URNA_TEMA="${URNA_TEMA:-aula}" \
      -e URNA_S3_ENDPOINT -e URNA_S3_BUCKET -e URNA_S3_REGION -e URNA_S3_PREFIX -e URNA_S3_ACCESS_KEY_ID -e URNA_S3_SECRET_ACCESS_KEY \
      -e DATABASE_URL="postgres://urna:$POSTGRES_PASSWORD@localhost:5432/urna" \
      -v "$home/fotos:/fotos:U" -v "$home/copias:/copias:ro" "$URNA_IMAGE_SERVER" >/dev/null
  fi
  if ! podman container exists "$pod-web"; then
    podman run -d --pod "$pod" --name "$pod-web" --restart=always \
      -e URNA_SITE="$URNA_SITE" -e URNA_SNI="$(site_address)" -e URNA_TLS="$(tls_block)" -e URNA_API=localhost:3000 \
      -v "$pod-caddy-data:/data" -v "$pod-caddy-config:/config" "$URNA_IMAGE_WEB" >/dev/null
  fi
  # The database first, so that the server finds it with its password.
  podman start "$pod-db" >/dev/null
  database_password
  podman pod start "$pod" >/dev/null
}

stop_all() {
  podman pod stop -t 20 "$pod" >/dev/null 2>&1 || true
}

# Containers go, data stays: it lives in volumes and folders.
replace_containers() {
  podman pod rm -f "$pod" >/dev/null 2>&1 || true
  start
}

# The command that shows what the server said last. Its container belongs to this user: whoever came in as root needs runuser.
server_logs() {
  if [ "${URNA_FROM_ROOT:-}" = si ]; then
    echo "sudo runuser -u $(id -un) -- env XDG_RUNTIME_DIR=/run/user/$(id -u) HOME=$home podman logs --tail 50 $pod-server"
  else
    echo "podman logs --tail 50 $pod-server"
  fi
}

server_restarts() {
  podman inspect --format '{{.RestartCount}}' "$pod-server" 2>/dev/null || echo ninguno
}

# 0 when the server answers, 1 when it does not answer yet. 2 when its container stops right after
# starting, as with a setting it cannot use: waiting would not help, so it shows what the server said.
wait_healthy() {
  restarts=$(server_restarts)
  for _ in $(seq 1 "${1:-120}"); do
    ask_here --max-time 5 "$health" >/dev/null 2>&1 && return 0
    if [ "$(server_restarts)" != "$restarts" ]; then
      echo 'El servidor se frena apenas arranca. Lo último que dijo:' >&2
      podman logs --tail 20 "$pod-server" 2>&1 | awk '!seen[$0]++' | tail -n 8 | sed 's/^/  /' >&2
      echo "Si es un dato de $home/.env, corregilo y corré «urna reiniciar». Mientras tanto, el sitio no anda." >&2
      return 2
    fi
    sleep 2
  done
  return 1
}

# After wait_healthy failed. If the server already said why, that is enough. If it only did not answer yet, everything
# keeps running, and it ends with 3: the first time it is almost always the certificate, waiting for the ports.
not_answering() {
  [ "$1" = 2 ] && exit 1
  echo 'Arrancó y queda andando, pero todavía no responde. La primera vez casi siempre falta el certificado, que llega cuando los puertos 80 y 443 están abiertos en el firewall de la nube. «urna estado» dice qué falta.' >&2
  exit 3
}

# The first backup, in the background, so that a new server says it is in order from the start.
first_backup() {
  ls "$home"/copias/urna-*.tar.gpg >/dev/null 2>&1 && return
  { systemctl --user start --no-block urna-copia.service || setsid "$0" copia; } </dev/null >/dev/null 2>&1 &
}

backup() {
  stamp=$(date -u +%Y%m%d-%H%M%S)
  work=$(mktemp -d)
  # Under another name until it is whole: a backup cut short never passes for one.
  partial="$home/copias/urna-$stamp.tar.gpg.parcial"
  trap 'rm -rf "$work" "$partial"' EXIT
  podman exec "$pod-db" pg_dump -U urna -Fc urna >"$work/base.dump"
  # The photos belong to the user inside the container, so it takes its namespace to read them.
  podman unshare tar -C "$home" -cf "$work/fotos.tar" fotos
  # The key of the sealed fields goes along: without it, a restored server cannot read them.
  printf '%s' "$URNA_FIELD_KEY" >"$work/clave-campos"
  printf '%s' "$URNA_BACKUP_KEY" >"$work/llave"
  chmod 600 "$work/llave"
  mkdir -p "$home/copias"
  tar -C "$work" -cf - base.dump fotos.tar clave-campos |
    gpg --batch --yes --quiet --pinentry-mode loopback --passphrase-file "$work/llave" --symmetric --cipher-algo AES256 \
      -o "$partial"
  chmod 644 "$partial"
  mv "$partial" "$home/copias/urna-$stamp.tar.gpg"
  # shellcheck disable=SC2012
  ls -1t "$home"/copias/urna-*.tar.gpg | tail -n +"$((keep + 1))" | while read -r old; do rm -f "$old"; done
  echo "$home/copias/urna-$stamp.tar.gpg"
  # Out of the server too, when there is a bucket: a free account can close with the machine and its copies inside.
  # The server sends it, because it already has the bucket's keys. Only the path goes to standard output.
  if has_bucket; then
    if podman exec "$pod-server" node apps/server/src/backup-upload.ts "/copias/urna-$stamp.tar.gpg" "$keep" >&2; then
      touch "$home/.copia-en-bucket"
    else
      echo "No se pudo mandar la copia al bucket $URNA_S3_BUCKET: quedó solo en este servidor." >&2
    fi
  fi
}

has_bucket() { [ -n "${URNA_S3_ENDPOINT:-}" ] && [ -n "${URNA_S3_BUCKET:-}" ]; }

# The backup comes as standard input (see the top). What gpg says tells a wrong key from a file that is not a backup.
# A backup can come from someone else, so nothing in it goes anywhere until every file is what a backup holds: its
# three files, the field key as the installation makes it, and photos inside their folder, none of them a link.
restore() {
  key=$1
  work=$(mktemp -d)
  staging=''
  trap 'rm -rf "$work"; [ -z "$staging" ] || { chmod -R u+w "$staging"; rm -rf "$staging"; }' EXIT
  printf '%s' "$key" >"$work/llave"
  chmod 600 "$work/llave"
  LC_ALL=C gpg --batch --quiet --pinentry-mode loopback --passphrase-file "$work/llave" --decrypt -o "$work/copia.tar" 2>"$work/gpg" || touch "$work/mal"
  if grep -q 'Bad session key' "$work/gpg"; then
    echo 'Esa llave no abre esta copia. Tiene que ser la llave de recuperación de la instalación que hizo la copia.' >&2
    exit 1
  fi
  incomplete() { echo 'Ese archivo no es una copia de Urna Abierta, o está incompleto. Bajalo de nuevo y volvé a probar.' >&2; exit 1; }
  strange() { echo "Esa copia trae $1, que una copia de Urna Abierta no tiene, así que no restauré nada. Si no la hiciste vos o alguien de confianza, no la uses." >&2; exit 1; }
  [ ! -e "$work/mal" ] && tar -tf "$work/copia.tar" >"$work/nombres" 2>/dev/null || incomplete
  while IFS= read -r name; do
    case "$name" in base.dump | fotos.tar | clave-campos) ;; *) strange 'un archivo de más' ;; esac
  done <"$work/nombres"
  [ -z "$(sort "$work/nombres" | uniq -d)" ] || strange 'un archivo repetido'
  [ "$(wc -l <"$work/nombres")" -eq 3 ] || incomplete
  # A link or anything else that is not a plain file.
  tar -tvf "$work/copia.tar" | grep -qv '^-' && strange 'un enlace'
  # Each file is read out of the backup when it is needed, never copied next to it: besides the photos, which have to
  # land somewhere, restoring takes no more room than the backup itself, where /tmp may be a small part of the memory.
  # What reads them says when one is not whole; a read cut short on purpose, as by head, says nothing.
  member() { tar -xOf "$work/copia.tar" "$1" 2>/dev/null; }
  [ "$(member base.dump | head -c 1 | wc -c)" -eq 1 ] || incomplete
  field_key=$(member clave-campos)
  case "$field_key" in *[!0-9a-f]*) strange 'una clave de campos rara' ;; esac
  [ "${#field_key}" -eq 64 ] || strange 'una clave de campos rara'
  member fotos.tar | tar -tf - >"$work/fotos" 2>/dev/null || incomplete
  grep -Evx 'fotos(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*/?' "$work/fotos" >/dev/null && strange 'archivos fuera de la carpeta de las fotos'
  member fotos.tar | tar -tvf - | grep -Eqv '^[-d]' && strange 'un enlace entre las fotos'
  # Next to where they go, so that putting them in place is only a rename.
  staging=$(mktemp -d "$home/.restaurando.XXXXXX")
  if [ -s "$work/fotos" ]; then member fotos.tar | tar -C "$staging" -xf - --no-same-owner fotos; fi
  mkdir -p "$staging/fotos"

  podman rm -f "$pod-server" >/dev/null 2>&1 || true
  # If the database does not let its data go, nothing changed yet: the site comes back as it was, and says why.
  if ! podman exec "$pod-db" psql -q -U urna -d urna -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' >/dev/null 2>"$work/base"; then
    echo "La base no me dejó reemplazar sus datos, así que no restauré nada. Dijo: $(tail -n 1 "$work/base")" >&2
    start || true
    exit 1
  fi
  member base.dump | podman exec -i "$pod-db" pg_restore -U urna -d urna --no-owner ||
    { echo 'La copia no terminó de entrar en la base, y el sitio quedó frenado para que no arranque con la mitad de los datos. Volvé a correr «urna restaurar» con la misma copia.' >&2; exit 1; }
  sed -i "s|^URNA_FIELD_KEY=.*|URNA_FIELD_KEY=$field_key|" "$home/.env"
  URNA_FIELD_KEY=$field_key
  podman unshare rm -rf "$home/fotos"
  mv "$staging/fotos" "$home/fotos"
  start
  wait_healthy 60 || not_answering $?
  echo "Copia restaurada. Las copias que se hagan desde ahora se abren con la llave de recuperación de este servidor."
  has_bucket || echo "Si las fotos iban a un bucket S3, completá las líneas URNA_S3_ de $home/.env y corré «urna reiniciar»: esos datos no entran en la copia."
}

# The newest published version: where GitHub's address for the latest release leads.
newest() {
  curl -fsSIL --max-time 30 -o /dev/null -w '%{url_effective}' "${URNA_RELEASES:-https://github.com/bafif/urna-abierta/releases/latest}" 2>/dev/null |
    sed -n 's|.*/releases/tag/\([A-Za-z0-9._-]*\)$|\1|p'
}

# The images of the new version, a backup, and then its commands and its containers. Nothing changes until it has both.
update() {
  version=${1:-$(newest)}
  case "$version" in
    '') echo 'No pude averiguar cuál es la última versión. Buscala en github.com/bafif/urna-abierta/releases y pedila, como en «urna actualizar v0.2.0».' >&2; exit 1 ;;
    [0-9]*) version=v$version ;;
  esac
  case "$version" in *[!A-Za-z0-9._-]*) echo "$version no es una versión: tiene que ser algo como v0.2.0." >&2; exit 2 ;; esac
  before=${URNA_IMAGE_SERVER##*:}
  server=${URNA_IMAGE_SERVER%:*}:$version
  web=${URNA_IMAGE_WEB%:*}:$version
  if [ "$server" = "$URNA_IMAGE_SERVER" ] && [ "$web" = "$URNA_IMAGE_WEB" ]; then
    echo "Ya está en la versión $version."
    return
  fi
  echo "Bajando la versión $version…"
  # A version never changes once published: if it is already here, it is the one.
  for image in "$server" "$web"; do
    podman image exists "$image" || podman pull -q "$image" >/dev/null || { echo "No se pudo bajar la versión $version. No cambié nada." >&2; exit 1; }
  done
  # The database keeps its major version, and gets its fixes when the registry answers.
  podman pull -q "$URNA_IMAGE_DB" >/dev/null 2>&1 || true
  # The version the last update came from, and the backup made just before it: once the newer version has changed
  # the database, that backup is the only way back to the older one, which refuses a database it does not know.
  older='' older_copy=''
  if [ -f "$home/.antes-de-actualizar" ]; then read -r older older_copy <"$home/.antes-de-actualizar" || true; fi
  echo 'Haciendo una copia antes de actualizar…'
  # As its own process, so that any step that fails stops it.
  copy=$("$0" copia) || { echo 'No se pudo hacer la copia, así que no cambié nada. Mirá «urna estado».' >&2; exit 1; }
  # Going back keeps the backup from before the update it undoes.
  [ "$version" = "$older" ] || printf '%s %s\n' "$before" "$copy" >"$home/.antes-de-actualizar"
  # Its commands replace these, but only if they read as a script. The running copy keeps its own file.
  if podman run --rm --network none --entrypoint cat "$server" /app/urna >"$home/urna.nueva" 2>/dev/null && [ -s "$home/urna.nueva" ] && sh -n "$home/urna.nueva"; then
    chmod 755 "$home/urna.nueva"
    mv "$home/urna.nueva" "$home/urna"
  else
    rm -f "$home/urna.nueva"
  fi
  sed -i "s|^URNA_IMAGE_SERVER=.*|URNA_IMAGE_SERVER=$server|; s|^URNA_IMAGE_WEB=.*|URNA_IMAGE_WEB=$web|" "$home/.env"
  echo "Arrancando la versión $version…"
  if ! "$home/urna" reiniciar >/dev/null; then
    if [ "$version" = "$older" ] && [ -f "$older_copy" ]; then
      echo "La versión $version no abre la base tal como la dejó la $before. Para volver a los datos de antes de actualizar: «urna restaurar $older_copy TU-LLAVE-DE-RECUPERACION». Lo que se cargó después quedó en $copy, que abre la $before." >&2
    else
      echo "La versión $version no arrancó. Para volver a la $before con los datos de antes: «urna actualizar $before» y después «urna restaurar $copy TU-LLAVE-DE-RECUPERACION». Si la $version llegó a cambiar la base, la $before no arranca hasta que restaures esa copia." >&2
    fi
    exit 1
  fi
  echo "Listo: está en la versión $version. La copia de antes quedó en $copy."
}

# Where the photos are, according to .env and according to the server, which may not have taken .env yet.
photos_status() {
  if [ -n "${URNA_S3_ENDPOINT:-}" ] && [ -n "${URNA_S3_BUCKET:-}" ]; then
    where="en el bucket $URNA_S3_BUCKET de $URNA_S3_ENDPOINT, cifradas. El bucket no entra en la copia"
    case "$1" in
      *'"storage":"disk"'*) check 'fotos' mal 'el servidor todavía las guarda en el disco. Corré «urna reiniciar» para que tome lo que dice .env' ;;
      *'"working":false'*) check 'fotos' mal "no se pueden guardar $where. Mirá qué dice el servidor con «$(server_logs)»" ;;
      # The check the server does on starting can take a minute when the bucket does not answer.
      *'"working":null'*) check 'fotos' espera "el servidor todavía está probando el bucket $URNA_S3_BUCKET. Volvé a correr «urna estado» en un minuto" ;;
      *'"storage":"s3"'*) check "fotos: $where" ok ;;
      # A server that does not answer cannot say whether they arrive, but where they go is still worth knowing.
      *) check 'fotos' espera "según .env se guardan $where. Hasta que el servidor conteste, no se sabe si llegan" ;;
    esac
  else
    case "$1" in
      *'"storage":"s3"'*) check 'fotos' mal 'el servidor las manda a un bucket que .env ya no nombra. Corré «urna reiniciar»' ;;
      *) check "fotos: en el disco, en $home/fotos, y entran en la copia" ok ;;
    esac
  fi
}

status() {
  problems=0
  # ok, aviso (worth knowing, but in order), espera (not confirmed yet) or anything else for a failure.
  check() {
    case "$2" in
      ok) printf 'bien   %s\n' "$1"; return ;;
      aviso) printf 'aviso  %s\n' "$1"; return ;;
      espera) printf 'espera %s: %s\n' "$1" "$3" ;;
      *) printf 'FALLA  %s: %s\n' "$1" "$3" ;;
    esac
    problems=$((problems + 1))
  }
  check "versión: ${URNA_IMAGE_SERVER##*:}" ok
  for name in db server web; do
    state=$(podman inspect --format '{{.State.Status}}' "$pod-$name" 2>/dev/null || echo ausente)
    [ "$state" = running ] && check "$name" ok || check "$name" mal "está $state. Probá «urna arrancar»"
  done
  answer=$(ask_here --max-time 10 "$health" 2>/dev/null || true)
  address=$(site_address)
  ends=$(echo | timeout 10 openssl s_client -connect "${URNA_TLS_CHECK:-localhost:443}" -servername "$address" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true)
  if [ -n "$answer" ]; then
    check 'el servidor responde' ok
  elif [ -z "$ends" ]; then
    # Without a certificate nobody gets in, this command neither: what is missing is the certificate, not the server.
    check 'el servidor responde' espera 'sin certificado no se le puede preguntar. Mirá el renglón del certificado'
  else
    check 'el servidor responde' mal "no contesta. Mirá lo último que dijo con «$(server_logs)»"
  fi
  photos_status "$answer"
  free=$(df -Pm "$home" | awk 'NR == 2 {print $4}')
  [ "$free" -gt 500 ] && check "disco: quedan $free MB" ok || check 'disco' mal "quedan $free MB. Borrá copias viejas"
  newest=$(find "$home/copias" -name 'urna-*.tar.gpg' -mmin -420 2>/dev/null | head -n 1)
  [ -n "$newest" ] && check 'hay una copia de las últimas 7 horas' ok || check 'copias' mal 'no hay una reciente. Probá «urna copia»'
  if ! has_bucket; then
    check 'las copias quedan solo en este servidor: si se pierde, se pierden con él. Bajá una desde la app cada tanto, o mandalas a un bucket S3' aviso
  elif [ -n "$(find "$home/.copia-en-bucket" -mmin -420 2>/dev/null)" ]; then
    check "las copias también van al bucket $URNA_S3_BUCKET" ok
  else
    check 'copias en el bucket' mal "ninguna de las últimas 7 horas llegó a $URNA_S3_BUCKET. Corré «urna copia» y fijate qué dice"
  fi
  if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo yes)" = yes ]; then check 'la hora está sincronizada' ok; else check 'hora' mal 'este servidor no sincroniza la hora'; fi
  if [ -n "$ends" ]; then check "certificado hasta: $ends" ok; else check 'certificado' mal "todavía no hay, y sin él nadie entra. Let's Encrypt lo da cuando llega a este servidor por los puertos 80 y 443: abrí TCP 80 y 443, y UDP 443, en el firewall de la nube, y en unos minutos llega solo"; fi
  [ "$problems" = 0 ] && echo 'Todo en orden.'
  return "$problems"
}

case "${1:-estado}" in
  arrancar)
    start
    # Its systemd unit only starts the pod: a wait tied to the unit would make systemd stop every container when
    # the certificate takes long, as it does while the ports are closed. Whoever installs waits with a second «arrancar».
    [ "${2:-}" = sin-esperar ] && exit 0
    answered=0
    wait_healthy || answered=$?
    # Also when it is only the certificate that is missing: the database is there, and a backup needs no certificate.
    [ "$answered" = 2 ] || first_backup
    [ "$answered" = 0 ] || not_answering "$answered"
    echo 'Andando.'
    ;;
  frenar) stop_all ;;
  copia) backup ;;
  restaurar)
    [ $# -eq 3 ] || { echo 'Uso: urna restaurar <archivo> <llave>' >&2; exit 2; }
    restore "$3"
    ;;
  actualizar) update "${2:-}" ;;
  reiniciar)
    replace_containers
    wait_healthy || not_answering $?
    echo 'Andando, con lo que dice .env.'
    ;;
  direccion)
    [ $# -eq 2 ] || { echo 'Uso: urna direccion <ip o dominio>' >&2; exit 2; }
    case "$2" in
      *[!0-9.]*) site=$2; cert=auto ;;
      *) site=https://$2; cert=ip ;;
    esac
    sed -i "s|^URNA_SITE=.*|URNA_SITE=$site|; s|^URNA_CERT=.*|URNA_CERT=$cert|" "$home/.env"
    podman rm -f "$pod-web" >/dev/null 2>&1 || true
    URNA_SITE=$site URNA_CERT=$cert start
    echo "Ahora está en $site. Cada fiscal va a tener que volver a preparar la mesa."
    ;;
  estado) status ;;
  *) sed -n '2,11p' "$0" | cut -c3-; exit 2 ;;
esac
