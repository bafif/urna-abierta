#!/bin/sh
# Runs Urna Abierta on a server: everything in one pod of rootless Podman, for the user `urna`.
#
#   urna estado              says whether everything is fine, and what to do if it is not
#   urna arrancar            starts it
#   urna frenar              stops it, without deleting anything
#   urna copia               makes an encrypted backup now, and sends it to the bucket if there is one
#   urna restaurar <archivo> <llave>   replaces the data with a backup, opened with the recovery key
#   urna actualizar [versión]          makes a backup and moves to the newest version, or to the one given
#   urna reiniciar           creates the containers again with what .env says, keeping the data
#   urna direccion <ip o dominio>      changes the address of the site
#   urna invitar ["nombre"]  a new invitation for someone with «Coordinar conmigo», or someone new with that task
#   urna alpine              moves the system to the newest version of Alpine, after a backup (as root)
#
# It answers in Spanish or in English: «urna --idioma en estado» chooses for one run (see language below).
set -eu

home=${URNA_HOME:-/opt/urna-abierta}
# --idioma es|en before the command, or URNA_IDIOMA, choose the language of the messages for one run. URNA_IDIOMA in
# .env keeps the one the installer was used in. Without either, the system's: Spanish when LANGUAGE, LC_ALL,
# LC_MESSAGES or LANG say Spanish, English for anything else.
case "${1:-}" in
  --idioma=*) URNA_IDIOMA=${1#--idioma=}; shift ;;
  --idioma) URNA_IDIOMA=${2:-}; shift; [ $# -eq 0 ] || shift ;;
esac
language() {
  for chosen in "${URNA_IDIOMA:-}" "$(sed -n 's/^URNA_IDIOMA=//p' "$home/.env" 2>/dev/null | tail -n 1)"; do
    case "$chosen" in es | en) echo "$chosen"; return ;; esac
  done
  for locale in "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
    case "$locale" in '' | C | C[._@]* | POSIX | POSIX[._@]*) ;; *) break ;; esac
  done
  case "$locale" in '' | C | C[._@]* | POSIX | POSIX[._@]*) echo en; return ;; esac
  for tag in $(printf '%s' "${LANGUAGE:-}" | tr ':' ' ') "$locale"; do
    case "$tag" in es | es[-_.@]*) echo es; return ;; esac
  done
  echo en
}
lang=$(language)
# What it runs again, as root or for a backup before updating, answers in the same language.
URNA_IDIOMA=$lang
export URNA_IDIOMA
# t 'en español' 'in English': the line in the language of the messages.
t() { if [ "$lang" = es ]; then printf '%s\n' "$1"; else printf '%s\n' "$2"; fi; }
# The backup to restore is opened first, from the folder the command was run in, and as root when it runs as root:
# it may be where the user `urna` cannot read, like the home of whoever connected. It goes on as standard input.
if [ "${1:-}" = restaurar ] && [ $# -eq 3 ] && [ "$2" != - ]; then
  [ -f "$2" ] || { t "No encuentro el archivo $2. Fijate la ruta, o pasala completa, como /home/alpine/copia.tar.age." "There is no file $2. Check the path, or give the full one, like /home/alpine/copia.tar.age." >&2; exit 1; }
  [ -r "$2" ] || { t "No puedo leer $2. Probá con sudo." "$2 cannot be read. Try with sudo." >&2; exit 1; }
  exec <"$2"
  set -- restaurar - "$3"
fi
# Whoever calls this may be in a folder that this user cannot enter.
cd /

# The newest stable version of Alpine, as 3.24, or nothing if it cannot be asked.
newest_alpine() {
  curl -fsS --max-time 8 "https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/$(apk --print-arch)/latest-releases.yaml" 2>/dev/null |
    sed -n 's/^ *branch: *v\([0-9][0-9.]*\)$/\1/p' | head -n 1
}
# Alpine fixes each version only until the next one comes out (Podman's repository, only until then): moving to the
# next is done as root, after a backup, and never by itself, as it changes more than fixes. If it stops halfway, running
# it again goes on from there. The new kernel is used after a reboot.
if [ "${1:-}" = alpine ]; then
  [ -f /etc/alpine-release ] || { t 'Este servidor no es Alpine: su sistema se actualiza como siempre.' 'This server is not Alpine: its system is updated the usual way.' >&2; exit 2; }
  [ "$(id -u)" = 0 ] || { t 'Corré «sudo urna alpine».' 'Run “sudo urna alpine”.' >&2; exit 2; }
  branch=$(sed -n 's|^[^#]*/alpine/v\([0-9][0-9.]*\)/main/*$|\1|p' /etc/apk/repositories | head -n 1)
  [ -n "$branch" ] || { t 'Los repositorios de este Alpine no siguen una versión fija: no los toco.' 'The repositories of this Alpine follow no fixed version: I leave them as they are.' >&2; exit 2; }
  target=$(newest_alpine)
  [ -n "$target" ] || { t 'No pude averiguar cuál es la última versión de Alpine. No cambié nada.' 'Could not find out the newest version of Alpine. Nothing changed.' >&2; exit 1; }
  if [ "$branch" = "$target" ] && [ "$(cut -d. -f1,2 /etc/alpine-release)" = "$target" ]; then
    t "Ya está en Alpine $target, la última." "It is already on Alpine $target, the newest."
    exit 0
  fi
  if [ "$branch" != "$target" ]; then
    "$0" copia || { t 'No pude hacer la copia de antes. No cambié nada.' 'Could not make the backup first. Nothing changed.' >&2; exit 1; }
    cp /etc/apk/repositories "/etc/apk/repositories.v$branch"
    sed -i "s|/v$branch/|/v$target/|g" /etc/apk/repositories
  fi
  t "Pasando a Alpine $target…" "Moving to Alpine $target…"
  if ! { apk update -q && apk upgrade -q --available --no-interactive; }; then
    t "No terminó: arriba está lo que dijo apk. Corré de nuevo «sudo urna alpine» y sigue desde ahí. Los repositorios de antes quedaron en /etc/apk/repositories.v$branch." "It did not finish: what apk said is above. Run “sudo urna alpine” again and it goes on from there. The repositories from before are in /etc/apk/repositories.v$branch." >&2
    exit 1
  fi
  t "Listo: Alpine $target. Reiniciá el servidor cuando no haya una elección en curso, con «sudo reboot»: Urna Abierta vuelve sola." "Done: Alpine $target. Restart the server when no election is going on, with “sudo reboot”: Urna Abierta comes back by itself."
  exit 0
fi

# As root, it runs as the user that owns the containers, and remembers it to say how to look at them.
if [ "$(id -u)" = 0 ] && [ "${URNA_RUN_AS_ROOT:-}" != si ]; then
  uid=$(id -u urna)
  exec runuser -u urna -- env XDG_RUNTIME_DIR="/run/user/$uid" HOME="$home" URNA_FROM_ROOT=si "$0" "$@"
fi

set -a
# shellcheck disable=SC1091
. "$home/.env"
set +a
URNA_IDIOMA=$lang
pod=${URNA_POD:-urna}
ports=${URNA_PORTS--p 80:80 -p 443:443 -p 443:443/udp}
# The address of the site, without its scheme: what its certificate is for.
site_address() { address=${URNA_SITE#https://}; printf '%s' "${address#http://}"; }
health=${URNA_HEALTH_URL:-https://$(site_address)/api/health}
# Asks this machine as a browser asks the site, by its address: Caddy only answers for that one, with its certificate.
ask_here() { curl -fsk --connect-to ::localhost: "$@"; }
keep=${URNA_BACKUPS_KEPT:-28}

# ip: a Let's Encrypt certificate for the bare address, which lasts days and renews by itself.
# auto: the usual one for a domain. internal: only for trying it out.
tls_block() {
  case "${URNA_CERT:-ip}" in
    ip) printf 'tls {\n\tissuer acme {\n\t\tdir https://acme-v02.api.letsencrypt.org/directory\n\t\tprofile shortlived\n\t}\n}' ;;
    internal) printf 'tls internal' ;;
    *) printf '' ;;
  esac
}

network() {
  # Both keep the real address of each phone, which the limit on guessing codes needs.
  if [ -n "${URNA_NETWORK:-}" ]; then
    echo "$URNA_NETWORK"
  elif command -v pasta >/dev/null 2>&1; then
    echo pasta
  else
    echo slirp4netns:port_handler=slirp4netns
  fi
}

# The database takes the password .env gives it, each time it starts: it is the one the server uses, and an installer
# that ran again on the same machine may have made a new one. Then a database made before, which trusted every
# connection from inside the pod, asks for it on the network from then on. Its socket, which is only inside its own
# container, keeps trusting: an older «urna», after going back to an older version, still makes and restores backups.
database_password() {
  podman exec -i -e POSTGRES_PASSWORD -u postgres "$pod-db" sh -s >/dev/null 2>&1 <<'EOF' || true
for _ in $(seq 1 60); do pg_isready -q -U urna -d urna && break; sleep 1; done
psql -X -q -v ON_ERROR_STOP=1 -U urna -d urna <<'SQL' || exit 1
\getenv password POSTGRES_PASSWORD
ALTER ROLE urna PASSWORD :'password';
SQL
grep -Eq '^[[:space:]]*host.*[[:space:]]trust[[:space:]]*$' "$PGDATA/pg_hba.conf" || exit 0
sed -i -E '/^[[:space:]]*host/ s/[[:space:]]trust[[:space:]]*$/ scram-sha-256/' "$PGDATA/pg_hba.conf"
psql -X -q -U urna -d urna -c 'SELECT pg_reload_conf()'
EOF
}

start() {
  mkdir -p "$home/fotos" "$home/copias"
  if ! podman pod exists "$pod"; then
    # shellcheck disable=SC2086
    podman pod create --name "$pod" --network "$(network)" $ports >/dev/null
  fi
  # The database asks for its password on every connection over the network, which the web container shares in the pod.
  if ! podman container exists "$pod-db"; then
    podman run -d --pod "$pod" --name "$pod-db" --restart=always \
      -e POSTGRES_USER=urna -e POSTGRES_DB=urna -e POSTGRES_PASSWORD="$POSTGRES_PASSWORD" -e POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 \
      -v "$pod-database:/var/lib/postgresql" "$URNA_IMAGE_DB" \
      postgres -c shared_buffers=128MB -c max_connections=20 -c work_mem=4MB -c effective_cache_size=384MB >/dev/null
  fi
  if ! podman container exists "$pod-server"; then
    podman run -d --pod "$pod" --name "$pod-server" --restart=always \
      -e URNA_ACEPTO_RESPONSABILIDAD=si -e PG_POOL_MAX=8 -e URNA_PHOTOS_DIR=/fotos -e URNA_BACKUPS_DIR=/copias \
      -e URNA_SETUP_CODE -e URNA_SETUP_CODE_HASH -e URNA_FIELD_KEY="$URNA_FIELD_KEY" -e URNA_TEMA="${URNA_TEMA:-aula}" \
      -e URNA_S3_ENDPOINT -e URNA_S3_BUCKET -e URNA_S3_REGION -e URNA_S3_PREFIX -e URNA_S3_ACCESS_KEY_ID -e URNA_S3_SECRET_ACCESS_KEY \
      -e DATABASE_URL="postgres://urna:$POSTGRES_PASSWORD@localhost:5432/urna" \
      -v "$home/fotos:/fotos:U,z" -v "$home/copias:/copias:ro,z" "$URNA_IMAGE_SERVER" >/dev/null
  fi
  if ! podman container exists "$pod-web"; then
    podman run -d --pod "$pod" --name "$pod-web" --restart=always \
      -e URNA_SITE="$URNA_SITE" -e URNA_SNI="$(site_address)" -e URNA_TLS="$(tls_block)" -e URNA_API=localhost:3000 \
      -v "$pod-caddy-data:/data" -v "$pod-caddy-config:/config" "$URNA_IMAGE_WEB" >/dev/null
  fi
  # The database first, so that the server finds it with its password.
  podman start "$pod-db" >/dev/null
  database_password
  podman pod start "$pod" >/dev/null
}

stop_all() {
  podman pod stop -t 20 "$pod" >/dev/null 2>&1 || true
}

# Containers go, data stays: it lives in volumes and folders.
replace_containers() {
  podman pod rm -f "$pod" >/dev/null 2>&1 || true
  start
}

# The command that shows what the server said last. Its container belongs to this user: whoever came in as root needs runuser.
server_logs() {
  if [ "${URNA_FROM_ROOT:-}" = si ]; then
    echo "sudo runuser -u $(id -un) -- env XDG_RUNTIME_DIR=/run/user/$(id -u) HOME=$home podman logs --tail 50 $pod-server"
  else
    echo "podman logs --tail 50 $pod-server"
  fi
}

server_restarts() {
  podman inspect --format '{{.RestartCount}}' "$pod-server" 2>/dev/null || echo ninguno
}

# 0 when the server answers, 1 when it does not answer yet. 2 when its container stops right after
# starting, as with a setting it cannot use: waiting would not help, so it shows what the server said.
wait_healthy() {
  restarts=$(server_restarts)
  for _ in $(seq 1 "${1:-120}"); do
    ask_here --max-time 5 "$health" >/dev/null 2>&1 && return 0
    if [ "$(server_restarts)" != "$restarts" ]; then
      t 'El servidor se frena apenas arranca. Lo último que dijo:' 'The server stops right after it starts. The last thing it said:' >&2
      podman logs --tail 20 "$pod-server" 2>&1 | awk '!seen[$0]++' | tail -n 8 | sed 's/^/  /' >&2
      t "Si es un dato de $home/.env, corregilo y corré «urna reiniciar». Mientras tanto, el sitio no anda." "If it is a setting in $home/.env, fix it and run “urna reiniciar”. Until then, the site is down." >&2
      return 2
    fi
    sleep 2
  done
  return 1
}

# When the certificate of the site ends, empty while there is none.
certificate_ends() {
  echo | timeout 10 openssl s_client -connect "${URNA_TLS_CHECK:-localhost:443}" -servername "$(site_address)" 2>/dev/null |
    openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true
}

# After wait_healthy failed. If the server already said why, that is enough. If it only did not answer yet and there is no
# certificate, everything keeps running and it ends with 3: the first time it is almost always the ports. With a
# certificate, not answering is a real failure.
not_answering() {
  [ "$1" = 2 ] && exit 1
  if [ -n "$(certificate_ends)" ]; then
    t "Arrancó, pero el servidor no responde, y el certificado ya está. Mirá lo último que dijo con «$(server_logs)»." "It started, but the server does not answer, and the certificate is already there. See the last thing it said with “$(server_logs)”." >&2
    exit 1
  fi
  t 'Arrancó y queda andando, pero todavía no responde. La primera vez casi siempre falta el certificado, que llega cuando los puertos 80 y 443 están abiertos en el firewall de la nube. «urna estado» dice qué falta.' 'It started and keeps running, but it does not answer yet. The first time, what is missing is almost always the certificate, which arrives once ports 80 and 443 are open in the cloud firewall. “urna estado” says what is missing.' >&2
  exit 3
}

# The backups there are, newest first. Those of an installation from before the public key end in .gpg.
backups() { ls -1t "$home"/copias/urna-*.tar.age "$home"/copias/urna-*.tar.gpg 2>/dev/null; }

# Each backup is encrypted to the installation's public key, in a container of the server's image with no network:
# this server can make backups, never open them. One installed before there was a public key keeps using the key in
# its .env, as it did.
seal() {
  if [ -n "${URNA_BACKUP_PUBLIC_KEY:-}" ]; then
    podman run --rm -i --network=none --pull=never "$URNA_IMAGE_SERVER" node apps/server/src/backup-key.ts cifrar "$URNA_BACKUP_PUBLIC_KEY"
  else
    printf '%s' "$URNA_BACKUP_KEY" >"$work/llave"
    chmod 600 "$work/llave"
    gpg --batch --yes --quiet --pinentry-mode loopback --passphrase-file "$work/llave" --symmetric --cipher-algo AES256
  fi
}

# The first backup, in the background, so that a new server says it is in order from the start.
first_backup() {
  [ -n "$(backups)" ] && return
  { systemctl --user start --no-block urna-copia.service || setsid "$0" copia; } </dev/null >/dev/null 2>&1 &
}

backup() {
  mkdir -p "$home/copias"
  # One backup at a time: then what a backup cut short left behind can go before the next one starts.
  exec 9>"$home/copias/.en-curso"
  flock -n 9 || { t 'Ya hay una copia en curso.' 'A backup is already in progress.' >&2; return 0; }
  rm -f "$home"/copias/urna-*.tar.*.parcial
  stamp=$(date -u +%Y%m%d-%H%M%S)
  extension=age
  [ -n "${URNA_BACKUP_PUBLIC_KEY:-}" ] || extension=gpg
  name="urna-$stamp.tar.$extension"
  work=$(mktemp -d)
  # Under another name until it is whole: a backup cut short never passes for one.
  partial="$home/copias/$name.parcial"
  trap 'rm -rf "$work" "$partial"' EXIT
  trap 'exit 1' INT TERM
  podman exec "$pod-db" pg_dump -U urna -Fc urna >"$work/base.dump"
  # The photos belong to the user inside the container, so it takes its namespace to read them.
  podman unshare tar -C "$home" -cf "$work/fotos.tar" fotos
  # The key of the sealed fields goes along: without it, a restored server cannot read them.
  printf '%s' "$URNA_FIELD_KEY" >"$work/clave-campos"
  mkdir -p "$home/copias"
  tar -C "$work" -cf - base.dump fotos.tar clave-campos | seal >"$partial"
  [ -s "$partial" ] || { t 'No se pudo cifrar la copia.' 'The backup could not be encrypted.' >&2; exit 1; }
  chmod 644 "$partial"
  mv "$partial" "$home/copias/$name"
  backups | tail -n +"$((keep + 1))" | while read -r old; do rm -f "$old"; done
  # The copies made before the last purge still have the names it erased: only the ones since then stay.
  purged=$(podman exec "$pod-db" psql -U urna -tAc "SELECT COALESCE(extract(epoch FROM max(purged_at))::bigint, 0) FROM elections" 2>/dev/null || echo 0)
  if [ "${purged:-0}" -gt 0 ]; then
    backups | while read -r old; do
      [ "$old" = "$home/copias/$name" ] && continue
      [ "$(stat -c %Y "$old")" -lt "$purged" ] && rm -f "$old"
    done
  fi
  echo "$home/copias/$name"
  # Out of the server too, when there is a bucket: a free account can close with the machine and its copies inside.
  # The server sends it, because it already has the bucket's keys. Only the path goes to standard output.
  if has_bucket; then
    purged_stamp=''
    [ "${purged:-0}" -gt 0 ] && purged_stamp=$(date -u -d "@$purged" +%Y%m%d-%H%M%S)
    if podman exec -e URNA_IDIOMA="$lang" "$pod-server" node apps/server/src/backup-upload.ts "/copias/$name" "$keep" "$purged_stamp" >&2; then
      touch "$home/.copia-en-bucket"
    else
      t "No se pudo mandar la copia al bucket $URNA_S3_BUCKET: quedó solo en este servidor." "The backup could not be sent to the bucket $URNA_S3_BUCKET: it is only on this server." >&2
    fi
  fi
}

has_bucket() { [ -n "${URNA_S3_ENDPOINT:-}" ] && [ -n "${URNA_S3_BUCKET:-}" ]; }

# The backup comes as standard input (see the top). Its first bytes say how it was encrypted: to the public key, which
# only the recovery key opens, or, made before there was one, with gpg and the key that was in .env. Either way the
# wrong key is told apart from a file that is not a backup. The key reaches the program that opens it through the
# environment, never as an argument.
# A backup can come from someone else, so nothing in it goes anywhere until every file is what a backup holds: its
# three files, the field key as the installation makes it, and photos inside their folder, none of them a link.
restore() {
  key=$1
  work=$(mktemp -d)
  staging=''
  trap 'rm -rf "$work"; [ -z "$staging" ] || { chmod -R u+w "$staging"; rm -rf "$staging"; }' EXIT
  dd bs=1 count=21 of="$work/cabeza" 2>/dev/null
  wrong_key=''
  if [ "$(cat "$work/cabeza")" = 'age-encryption.org/v1' ]; then
    opened=0
    cat "$work/cabeza" - | URNA_LLAVE=$key podman run --rm -i --network=none --pull=never -e URNA_LLAVE "$URNA_IMAGE_SERVER" \
      node apps/server/src/backup-key.ts abrir >"$work/copia.tar" 2>"$work/abrir" || opened=$?
    [ "$opened" = 2 ] && wrong_key=si
    [ "$opened" = 0 ] || touch "$work/mal"
  else
    printf '%s' "$key" >"$work/llave"
    chmod 600 "$work/llave"
    cat "$work/cabeza" - | LC_ALL=C gpg --batch --quiet --pinentry-mode loopback --passphrase-file "$work/llave" --decrypt -o "$work/copia.tar" 2>"$work/gpg" || touch "$work/mal"
    grep -q 'Bad session key' "$work/gpg" && wrong_key=si
  fi
  if [ -n "$wrong_key" ]; then
    t 'Esa llave no abre esta copia. Tiene que ser la llave de recuperación de la instalación que hizo la copia: la del archivo de acceso, que empieza con AGE-SECRET-KEY-1.' 'That key does not open this backup. It has to be the recovery key of the installation that made it: the one in the access file, which starts with AGE-SECRET-KEY-1.' >&2
    exit 1
  fi
  incomplete() { t 'Ese archivo no es una copia de Urna Abierta, o está incompleto. Bajalo de nuevo y volvé a probar.' 'That file is not an Urna Abierta backup, or it is incomplete. Download it again and try once more.' >&2; exit 1; }
  # strange 'lo que trae' 'what it has'
  strange() { t "Esa copia trae $1, que una copia de Urna Abierta no tiene, así que no restauré nada. Si no la hiciste vos o alguien de confianza, no la uses." "That backup has $2, which an Urna Abierta backup does not have, so nothing was restored. If neither you nor someone you trust made it, do not use it." >&2; exit 1; }
  [ ! -e "$work/mal" ] && tar -tf "$work/copia.tar" >"$work/nombres" 2>/dev/null || incomplete
  while IFS= read -r name; do
    case "$name" in base.dump | fotos.tar | clave-campos) ;; *) strange 'un archivo de más' 'an extra file' ;; esac
  done <"$work/nombres"
  [ -z "$(sort "$work/nombres" | uniq -d)" ] || strange 'un archivo repetido' 'a repeated file'
  [ "$(wc -l <"$work/nombres")" -eq 3 ] || incomplete
  # A link or anything else that is not a plain file.
  tar -tvf "$work/copia.tar" | grep -qv '^-' && strange 'un enlace' 'a link'
  # Each file is read out of the backup when it is needed, never copied next to it: besides the photos, which have to
  # land somewhere, restoring takes no more room than the backup itself, where /tmp may be a small part of the memory.
  # What reads them says when one is not whole; a read cut short on purpose, as by head, says nothing.
  member() { tar -xOf "$work/copia.tar" "$1" 2>/dev/null; }
  [ "$(member base.dump | head -c 1 | wc -c)" -eq 1 ] || incomplete
  field_key=$(member clave-campos)
  case "$field_key" in *[!0-9a-f]*) strange 'una clave de campos rara' 'an odd field key' ;; esac
  [ "${#field_key}" -eq 64 ] || strange 'una clave de campos rara' 'an odd field key'
  member fotos.tar | tar -tf - >"$work/fotos" 2>/dev/null || incomplete
  grep -Evx 'fotos(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*/?' "$work/fotos" >/dev/null && strange 'archivos fuera de la carpeta de las fotos' 'files outside the photos folder'
  member fotos.tar | tar -tvf - | grep -Eqv '^[-d]' && strange 'un enlace entre las fotos' 'a link among the photos'
  # Next to where they go, so that putting them in place is only a rename.
  staging=$(mktemp -d "$home/.restaurando.XXXXXX")
  if [ -s "$work/fotos" ]; then member fotos.tar | tar -C "$staging" -xf - --no-same-owner fotos; fi
  mkdir -p "$staging/fotos"

  podman rm -f "$pod-server" >/dev/null 2>&1 || true
  # If the database does not let its data go, nothing changed yet: the site comes back as it was, and says why.
  if ! podman exec "$pod-db" psql -q -U urna -d urna -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' >/dev/null 2>"$work/base"; then
    t "La base no me dejó reemplazar sus datos, así que no restauré nada. Dijo: $(tail -n 1 "$work/base")" "The database did not let its data be replaced, so nothing was restored. It said: $(tail -n 1 "$work/base")" >&2
    start || true
    exit 1
  fi
  member base.dump | podman exec -i "$pod-db" pg_restore -U urna -d urna --no-owner ||
    { t 'La copia no terminó de entrar en la base, y el sitio quedó frenado para que no arranque con la mitad de los datos. Volvé a correr «urna restaurar» con la misma copia.' 'The backup did not finish going into the database, and the site was left stopped so that it does not start with half the data. Run “urna restaurar” again with the same backup.' >&2; exit 1; }
  sed -i "s|^URNA_FIELD_KEY=.*|URNA_FIELD_KEY=$field_key|" "$home/.env"
  URNA_FIELD_KEY=$field_key
  podman unshare rm -rf "$home/fotos"
  mv "$staging/fotos" "$home/fotos"
  start
  wait_healthy 60 || not_answering $?
  t "Copia restaurada. Las copias que se hagan desde ahora se abren con la llave de recuperación de este servidor." "Backup restored. Backups made from now on open with the recovery key of this server."
  has_bucket || t "Si las fotos iban a un bucket S3, completá las líneas URNA_S3_ de $home/.env y corré «urna reiniciar»: esos datos no entran en la copia." "If the photos went to an S3 bucket, fill in the URNA_S3_ lines of $home/.env and run “urna reiniciar”: those settings are not in the backup."
}

# The newest published version: where GitHub's address for the latest release leads.
newest() {
  curl -fsSIL --max-time 30 -o /dev/null -w '%{url_effective}' "${URNA_RELEASES:-https://github.com/bafif/urna-abierta/releases/latest}" 2>/dev/null |
    sed -n 's|.*/releases/tag/\([A-Za-z0-9._-]*\)$|\1|p'
}

# The images of the new version, a backup, and then its commands and its containers. Nothing changes until it has both.
update() {
  version=${1:-$(newest)}
  case "$version" in
    '') t 'No pude averiguar cuál es la última versión. Buscala en github.com/bafif/urna-abierta/releases y pedila, como en «urna actualizar v0.2.0».' 'Could not find out which version is the newest. Look it up at github.com/bafif/urna-abierta/releases and ask for it, as in “urna actualizar v0.2.0”.' >&2; exit 1 ;;
    [0-9]*) version=v$version ;;
  esac
  case "$version" in *[!A-Za-z0-9._-]*) t "$version no es una versión: tiene que ser algo como v0.2.0." "$version is not a version: it has to be something like v0.2.0." >&2; exit 2 ;; esac
  before=${URNA_IMAGE_SERVER##*:}
  server=${URNA_IMAGE_SERVER%:*}:$version
  web=${URNA_IMAGE_WEB%:*}:$version
  if [ "$server" = "$URNA_IMAGE_SERVER" ] && [ "$web" = "$URNA_IMAGE_WEB" ]; then
    t "Ya está en la versión $version." "It is already on version $version."
    return
  fi
  t "Bajando la versión $version…" "Downloading version $version…"
  # A version never changes once published: if it is already here, it is the one.
  for image in "$server" "$web"; do
    podman image exists "$image" || podman pull -q "$image" >/dev/null || { t "No se pudo bajar la versión $version. No cambié nada." "Version $version could not be downloaded. Nothing changed." >&2; exit 1; }
  done
  # The database keeps its major version, and gets its fixes when the registry answers.
  podman pull -q "$URNA_IMAGE_DB" >/dev/null 2>&1 || true
  # The version the last update came from, and the backup made just before it: once the newer version has changed
  # the database, that backup is the only way back to the older one, which refuses a database it does not know.
  older='' older_copy=''
  if [ -f "$home/.antes-de-actualizar" ]; then read -r older older_copy <"$home/.antes-de-actualizar" || true; fi
  t 'Haciendo una copia antes de actualizar…' 'Making a backup before updating…'
  # As its own process, so that any step that fails stops it.
  copy=$("$0" copia) || { t 'No se pudo hacer la copia, así que no cambié nada. Mirá «urna estado».' 'The backup could not be made, so nothing changed. Look at “urna estado”.' >&2; exit 1; }
  # Going back keeps the backup from before the update it undoes.
  [ "$version" = "$older" ] || printf '%s %s\n' "$before" "$copy" >"$home/.antes-de-actualizar"
  # Its commands replace these, but only if they read as a script. The running copy keeps its own file.
  if podman run --rm --network none --entrypoint cat "$server" /app/urna >"$home/urna.nueva" 2>/dev/null && [ -s "$home/urna.nueva" ] && sh -n "$home/urna.nueva"; then
    chmod 755 "$home/urna.nueva"
    mv "$home/urna.nueva" "$home/urna"
  else
    rm -f "$home/urna.nueva"
  fi
  sed -i "s|^URNA_IMAGE_SERVER=.*|URNA_IMAGE_SERVER=$server|; s|^URNA_IMAGE_WEB=.*|URNA_IMAGE_WEB=$web|" "$home/.env"
  t "Arrancando la versión $version…" "Starting version $version…"
  if ! "$home/urna" reiniciar >/dev/null; then
    if [ "$version" = "$older" ] && [ -f "$older_copy" ]; then
      t "La versión $version no abre la base tal como la dejó la $before. Para volver a los datos de antes de actualizar: «urna restaurar $older_copy TU-LLAVE-DE-RECUPERACION». Lo que se cargó después quedó en $copy, que abre la $before." "Version $version cannot open the database as $before left it. To go back to the data from before the update: “urna restaurar $older_copy YOUR-RECOVERY-KEY”. What was entered after that is in $copy, which $before opens." >&2
    else
      t "La versión $version no arrancó. Para volver a la $before con los datos de antes: «urna actualizar $before» y después «urna restaurar $copy TU-LLAVE-DE-RECUPERACION». Si la $version llegó a cambiar la base, la $before no arranca hasta que restaures esa copia." "Version $version did not start. To go back to $before with the data from before: “urna actualizar $before” and then “urna restaurar $copy YOUR-RECOVERY-KEY”. If $version got to change the database, $before does not start until you restore that backup." >&2
    fi
    exit 1
  fi
  t "Listo: está en la versión $version. La copia de antes quedó en $copy." "Done: it is on version $version. The backup from before is in $copy."
}

# Where the photos are, according to .env and according to the server, which may not have taken .env yet.
photos_status() {
  if [ -n "${URNA_S3_ENDPOINT:-}" ] && [ -n "${URNA_S3_BUCKET:-}" ]; then
    where=$(t "en el bucket $URNA_S3_BUCKET de $URNA_S3_ENDPOINT, cifradas. El bucket no entra en la copia" "in the bucket $URNA_S3_BUCKET at $URNA_S3_ENDPOINT, encrypted. The bucket is not part of the backup")
    photos=$(t fotos photos)
    case "$1" in
      *'"storage":"disk"'*) check "$photos" mal "$(t 'el servidor todavía las guarda en el disco. Corré «urna reiniciar» para que tome lo que dice .env' 'the server still keeps them on disk. Run “urna reiniciar” so that it takes what .env says')" ;;
      *'"working":false'*) check "$photos" mal "$(t "no se pueden guardar $where. Mirá qué dice el servidor con «$(server_logs)»" "they cannot be saved $where. See what the server says with “$(server_logs)”")" ;;
      # The check the server does on starting can take a minute when the bucket does not answer.
      *'"working":null'*) check "$photos" espera "$(t "el servidor todavía está probando el bucket $URNA_S3_BUCKET. Volvé a correr «urna estado» en un minuto" "the server is still testing the bucket $URNA_S3_BUCKET. Run “urna estado” again in a minute")" ;;
      *'"storage":"s3"'*) check "$photos: $where" ok ;;
      # A server that does not answer cannot say whether they arrive, but where they go is still worth knowing.
      *) check "$photos" espera "$(t "según .env se guardan $where. Hasta que el servidor conteste, no se sabe si llegan" "according to .env they are saved $where. Until the server answers, there is no knowing whether they arrive")" ;;
    esac
  else
    case "$1" in
      *'"storage":"s3"'*) check "$(t fotos photos)" mal "$(t 'el servidor las manda a un bucket que .env ya no nombra. Corré «urna reiniciar»' 'the server sends them to a bucket that .env no longer names. Run “urna reiniciar”')" ;;
      *) check "$(t "fotos: en el disco, en $home/fotos, y entran en la copia" "photos: on disk, in $home/fotos, and they are part of the backup")" ok ;;
    esac
  fi
}

# systemd says it with timedatectl; Alpine keeps the clock with chrony. Without either, nothing to check.
clock_synchronized() {
  if command -v timedatectl >/dev/null 2>&1; then
    [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo yes)" = yes ]
  elif command -v chronyc >/dev/null 2>&1; then
    chronyc -n tracking 2>/dev/null | grep -q '^Leap status *: Normal'
  fi
}
status() {
  problems=0
  # ok, aviso (worth knowing, but in order), espera (not confirmed yet) or anything else for a failure.
  check() {
    case "$2" in
      ok) printf '%-7s%s\n' "$(t bien ok)" "$1"; return ;;
      aviso) printf '%-7s%s\n' "$(t aviso note)" "$1"; return ;;
      espera) printf '%-7s%s: %s\n' "$(t espera wait)" "$1" "$3" ;;
      *) printf '%-7s%s: %s\n' "$(t FALLA FAIL)" "$1" "$3" ;;
    esac
    problems=$((problems + 1))
  }
  check "$(t versión version): ${URNA_IMAGE_SERVER##*:}" ok
  for name in db server web; do
    state=$(podman inspect --format '{{.State.Status}}' "$pod-$name" 2>/dev/null || t ausente missing)
    [ "$state" = running ] && check "$name" ok || check "$name" mal "$(t "está $state. Probá «urna arrancar»" "it is $state. Try “urna arrancar”")"
  done
  answer=$(ask_here --max-time 10 "$health" 2>/dev/null || true)
  ends=$(certificate_ends)
  answers=$(t 'el servidor responde' 'the server answers')
  if [ -n "$answer" ]; then
    check "$answers" ok
  elif [ -z "$ends" ]; then
    # Without a certificate nobody gets in, this command neither: what is missing is the certificate, not the server.
    check "$answers" espera "$(t 'sin certificado no se le puede preguntar. Mirá el renglón del certificado' 'without a certificate it cannot be asked. See the certificate line')"
  else
    check "$answers" mal "$(t "no contesta. Mirá lo último que dijo con «$(server_logs)»" "it does not answer. See the last thing it said with “$(server_logs)”")"
  fi
  photos_status "$answer"
  free=$(df -Pm "$home" | awk 'NR == 2 {print $4}')
  [ "$free" -gt 500 ] && check "$(t "disco: quedan $free MB" "disk: $free MB left")" ok || check "$(t disco disk)" mal "$(t "quedan $free MB. Borrá copias viejas" "$free MB left. Delete old backups")"
  newest=$(find "$home/copias" \( -name 'urna-*.tar.age' -o -name 'urna-*.tar.gpg' \) -mmin -420 2>/dev/null | head -n 1)
  [ -n "$newest" ] && check "$(t 'hay una copia de las últimas 7 horas' 'there is a backup from the last 7 hours')" ok || check "$(t copias backups)" mal "$(t 'no hay una reciente. Probá «urna copia»' 'there is no recent one. Try “urna copia”')"
  if ! has_bucket; then
    check "$(t 'las copias quedan solo en este servidor: si se pierde, se pierden con él. Bajá una desde la app cada tanto, o mandalas a un bucket S3' 'backups are only on this server: if it is lost, they are lost with it. Download one from the app now and then, or send them to an S3 bucket')" aviso
  elif [ -n "$(find "$home/.copia-en-bucket" -mmin -420 2>/dev/null)" ]; then
    check "$(t "las copias también van al bucket $URNA_S3_BUCKET" "backups also go to the bucket $URNA_S3_BUCKET")" ok
  else
    check "$(t 'copias en el bucket' 'backups in the bucket')" mal "$(t "ninguna de las últimas 7 horas llegó a $URNA_S3_BUCKET. Corré «urna copia» y fijate qué dice" "none from the last 7 hours reached $URNA_S3_BUCKET. Run “urna copia” and see what it says")"
  fi
  if [ -f /etc/alpine-release ]; then
    alpine=$(cut -d. -f1,2 /etc/alpine-release)
    newer=$(newest_alpine)
    if [ -n "$newer" ] && [ "$newer" != "$alpine" ]; then
      check "$(t "salió Alpine $newer, y la $alpine deja de recibir arreglos de Podman. Pasá con «sudo urna alpine» un día sin elección" "Alpine $newer is out, and $alpine stops getting Podman fixes. Move with “sudo urna alpine” on a day with no election")" aviso
    fi
  fi
  if clock_synchronized; then check "$(t 'la hora está sincronizada' 'the clock is synchronized')" ok; else check "$(t hora clock)" mal "$(t 'este servidor no sincroniza la hora' 'this server does not synchronize its clock')"; fi
  if [ -n "$ends" ]; then check "$(t "certificado hasta: $ends" "certificate until: $ends")" ok; else check "$(t certificado certificate)" mal "$(t "todavía no hay, y sin él nadie entra. Let's Encrypt lo da cuando llega a este servidor por los puertos 80 y 443: abrí TCP 80 y 443, y UDP 443, en el firewall de la nube. Llega solo, aunque si los puertos estuvieron cerrados mucho tiempo puede tardar horas: «urna reiniciar» lo pide de nuevo enseguida" "there is none yet, and without it nobody gets in. Let's Encrypt issues it when it reaches this server on ports 80 and 443: open TCP 80 and 443, and UDP 443, in the cloud firewall. It arrives by itself, although if the ports were closed for a long time it can take hours: “urna reiniciar” asks for it again right away")"; fi
  [ "$problems" = 0 ] && t 'Todo en orden.' 'All in order.'
  return "$problems"
}

# The way back in when nobody with «Coordinar conmigo» can get in. Whoever can run this can already read the whole
# database, so it gives them nothing new; it goes in the log. The server prints the invitation on its last line.
invite() {
  podman container exists "$pod-server" || { t 'El servidor no está andando: corré «urna arrancar».' 'The server is not running: run “urna arrancar”.' >&2; exit 1; }
  code=0
  answer=$(podman exec -e URNA_IDIOMA="$lang" "$pod-server" node apps/server/src/invite-from-server.ts "$*") || code=$?
  case $code in
    0)
      printf '%s\n' "$answer" | sed '$d'
      echo
      printf '  %s/#invitacion=%s\n' "${URNA_SITE%/}" "$(printf '%s\n' "$answer" | tail -n 1)"
      echo
      t 'Abrila en el teléfono de esa persona, o mandásela por un medio en el que confíes: con ella entra cualquiera.' 'Open it on that person'"'"'s phone, or send it through a channel you trust: anyone gets in with it.'
      ;;
    3)
      printf '%s\n' "$answer"
      t 'Para darle una invitación nueva a una de esas personas, o sumar a alguien nuevo con esa tarea: urna invitar "nombre"' 'To give one of them a new invitation, or to add someone new with that task: urna invitar "name"'
      ;;
    *) exit 1 ;;
  esac
}

usage() {
  if [ "$lang" = es ]; then
    cat <<'EOF'
urna estado              dice si está todo bien y, si no, qué hacer
urna arrancar            lo arranca
urna frenar              lo frena, sin borrar nada
urna copia               hace ahora una copia cifrada, y la manda al bucket si hay uno
urna restaurar <archivo> <llave>   reemplaza los datos por los de una copia
urna actualizar [versión]          hace una copia y pasa a la última versión, o a la que se pida
urna reiniciar           vuelve a crear los contenedores con lo que dice .env, sin tocar los datos
urna direccion <ip o dominio>      cambia la dirección del sitio
urna invitar ["nombre"]  una invitación nueva para alguien con «Coordinar conmigo», o alguien nuevo con esa tarea
urna alpine              pasa el sistema a la última versión de Alpine, después de una copia (como root)

Con --idioma en o --idioma es antes del comando, contesta en ese idioma.
EOF
  else
    cat <<'EOF'
urna estado              says whether everything is fine, and what to do if it is not
urna arrancar            starts it
urna frenar              stops it, without deleting anything
urna copia               makes an encrypted backup now, and sends it to the bucket if there is one
urna restaurar <file> <key>        replaces the data with a backup
urna actualizar [version]          makes a backup and moves to the newest version, or to the one given
urna reiniciar           creates the containers again with what .env says, keeping the data
urna direccion <ip or domain>      changes the address of the site
urna invitar ["name"]    a new invitation for someone with “Coordinate with me”, or someone new with that task
urna alpine              moves the system to the newest version of Alpine, after a backup (as root)

With --idioma es or --idioma en before the command, it answers in that language.
EOF
  fi
}

case "${1:-estado}" in
  arrancar)
    start
    # Its service (systemd or OpenRC) only starts the pod: a wait tied to it would make systemd stop every container,
    # or hold OpenRC's boot, when the certificate takes long, as it does while the ports are closed. Whoever installs waits with a second «arrancar».
    [ "${2:-}" = sin-esperar ] && exit 0
    answered=0
    wait_healthy || answered=$?
    # Also when it is only the certificate that is missing: the database is there, and a backup needs no certificate.
    [ "$answered" = 2 ] || first_backup
    [ "$answered" = 0 ] || not_answering "$answered"
    t 'Andando.' 'Running.'
    ;;
  frenar) stop_all ;;
  copia) backup ;;
  restaurar)
    [ $# -eq 3 ] || { t 'Uso: urna restaurar <archivo> <llave>' 'Usage: urna restaurar <file> <key>' >&2; exit 2; }
    restore "$3"
    ;;
  actualizar) update "${2:-}" ;;
  reiniciar)
    replace_containers
    wait_healthy || not_answering $?
    t 'Andando, con lo que dice .env.' 'Running, with what .env says.'
    ;;
  direccion)
    [ $# -eq 2 ] || { t 'Uso: urna direccion <ip o dominio>' 'Usage: urna direccion <ip or domain>' >&2; exit 2; }
    case "$2" in
      *[!0-9.]*) site=$2; cert=auto ;;
      *) site=https://$2; cert=ip ;;
    esac
    sed -i "s|^URNA_SITE=.*|URNA_SITE=$site|; s|^URNA_CERT=.*|URNA_CERT=$cert|" "$home/.env"
    podman rm -f "$pod-web" >/dev/null 2>&1 || true
    URNA_SITE=$site URNA_CERT=$cert start
    t "Ahora está en $site. Cada fiscal va a tener que volver a preparar la mesa." "It is now at $site. Every poll watcher will have to prepare their table again."
    ;;
  invitar) shift; invite "$@" ;;
  estado) status ;;
  *) usage; exit 2 ;;
esac
